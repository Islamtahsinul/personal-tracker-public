# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase: both values are in your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- External enrichment providers (all optional; app works without them) ---
# TMDB (movies + tv): https://www.themoviedb.org/settings/api -> API Read Access Token (v4 auth)
TMDB_API_KEY=

# IGDB (games), via Twitch developer app: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Open Library (books) and Wikidata/Wikipedia (cars, motorcycles) need no API key.
